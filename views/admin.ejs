<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            background: #f5f0e8;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background: #2c3e50;
            color: white;
            padding: 20px;
            border: 5px solid #1a252f;
            margin-bottom: 20px;
            text-align: center;
        }
        .setting {
            background: white;
            padding: 12px;
            margin: 8px 0;
            border: 2px solid #999;
        }
        label { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .btn {
            display: inline-block;
            padding: 10px 20px;
            background: #c0392b;
            color: white;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            font-size: 14px;
        }
        .btn:hover { background: #8b0000; }
        .comment-item {
            background: white;
            padding: 10px;
            margin: 5px 0;
            border: 1px solid #ccc;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .comment-text { font-size: 13px; flex: 1; word-break: break-word; }
        .delete-btn {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            margin-left: 10px;
        }
        .delete-btn:hover { background: #c0392b; }
        .place-tag {
            background: #ddd;
            padding: 2px 6px;
            font-size: 11px;
            margin-right: 5px;
        }
        hr { margin: 20px 0; border: 1px solid #ccc; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Админ-панель</h1>
        <p>Управление городом N</p>
    </div>

    <h2>Настройки заведений</h2>
    <form action="/admin" method="POST">
        <div class="setting">
            <label>
                <input type="checkbox" name="show_time" <%= settings.show_time ? 'checked' : '' %>>
                <strong>Показывать время в комментариях</strong>
            </label>
        </div>

        <% Object.keys(places).forEach(key => { %>
            <div class="setting">
                <label>
                    <input type="checkbox" name="<%= key %>_open" <%= settings[key + '_open'] ? 'checked' : '' %>>
                    <strong><%= places[key].name %></strong>
                </label>
            </div>
        <% }); %>

        <button type="submit" class="btn">Сохранить настройки</button>
    </form>

    <p><a href="/?logout=admin">Выйти из админки</a></p>

    <hr>

    <h2>Все комментарии</h2>
    <% if (comments.length === 0) { %>
        <p>Комментариев пока нет.</p>
    <% } %>

    <% comments.forEach(comment => { %>
        <div class="comment-item">
            <div>
                <span class="place-tag"><%= comment.place %></span>
                <strong><%= comment.nickname %></strong>
                <span class="comment-text"><%= comment.text.substring(0, 80) %><%= comment.text.length > 80 ? '...' : '' %></span>
            </div>
            <form action="/admin/delete-comment" method="POST" style="display:inline;">
                <input type="hidden" name="comment_id" value="<%= comment.id %>">
                <button type="submit" class="delete-btn" onclick="return confirm('Удалить этот комментарий?')">Удалить</button>
            </form>
        </div>
    <% }); %>

    <p style="margin-top: 20px;"><a href="/">← В меню</a></p>
</body>
</html>