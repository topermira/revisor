<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль <%= user.nickname %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header">
        <h1>КАРТОЧКА ПАЦИЕНТА</h1>
        <p>История болезни №<%= user.id %></p>
    </div>

    <div style="background: white; padding: 20px; border: 2px solid #999; margin: 20px 0; text-align: center;">
        <img src="<%= user.avatar_url %>" alt="Аватар" class="avatar-large" onclick="openImage(this.src)" style="cursor: pointer;">
        <h2><%= user.nickname %></h2>
        <p>Пациент с <%= user.registered_year %> года</p>
    </div>

    <% if (isOwner) { %>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <div style="background: white; padding: 20px; border: 2px solid #999; margin: 20px 0;">
            <h3>Редактировать карточку:</h3>
            <form action="/profile/<%= user.id %>" method="POST" enctype="multipart/form-data">
                <label>Новый никнейм:</label>
                <input type="text" name="nickname" value="<%= user.nickname %>">
                
                <label>Новый пароль (оставьте пустым, если не меняете):</label>
                <input type="password" name="password" placeholder="Новый пароль">
                
                <label>Новая аватарка:</label>
                <input type="file" name="avatar" accept="image/*">

                <label>Год регистрации:</label>
                <input type="number" name="registered_year" value="<%= user.registered_year %>" min="1800" max="2100">
                
                <button type="submit" class="btn">Сохранить изменения</button>
            </form>
        </div>
    <% } %>

    <p><a href="/">← На главную</a></p>
<div id="imageOverlay" onclick="this.style.display='none'" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:1000; text-align:center;">
    <img id="bigImage" style="max-width:70%; max-height:70%; margin-top:8%; border:4px solid #c0392b; border-radius:10px;">
</div>

<script>
function openImage(src) {
    document.getElementById('bigImage').src = src;
    document.getElementById('imageOverlay').style.display = 'block';
}
</script>
<% if (isOwner) { %>
<div style="text-align: center; margin: 20px 0;">
    <a href="/logout" style="display: inline-block; padding: 10px 20px; background: #999; color: white; text-decoration: none; font-family: 'Courier New', monospace;">Выйти из профиля</a>
</div>
<% } %>
</body>
</html>