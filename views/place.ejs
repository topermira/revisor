<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= placeData.name %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header">
        <a href="/" style="color: white; float: left; text-decoration: none;">← В меню</a>
        <h1><%= placeData.icon %> <%= placeData.name.toUpperCase() %></h1>
        <p><em>— <%= placeData.chief %>, <%= placeData.name.toLowerCase() %> —</em></p>
    </div>

    <div style="background: white; padding: 15px; border: 2px solid #999; margin: 20px 0; font-style: italic;">
        <p style="white-space: pre-wrap; word-break: break-word;"><%= placeData.desc %></p>
    </div>

    <div style="margin: 20px 0;">
        <% if (currentUser) { %>
            <p>Вы вошли как: <strong><%= currentUser.nickname %></strong> 
            <a href="/profile/<%= currentUser.id %>" class="btn">Мой профиль</a>
            <a href="/logout" class="btn">Выйти</a></p>
        <% } else { %>
            <a href="/register" class="btn">Зарегистрироваться</a>
            <a href="/login" class="btn">Войти</a>
        <% } %>
    </div>

    <% if (currentUser) { %>
        <div style="background: white; padding: 15px; border: 2px solid #999; margin: 20px 0;">
            <h3>Оставить отзыв:</h3>
            <form action="/comment/<%= place %>" method="POST">
                <textarea name="text" rows="3" class="comment-text" placeholder="Ваше мнение..."></textarea>
                <button type="submit" class="btn">Отправить</button>
            </form>
        </div>
    <% } %>

    <h2> Отзывы посетителей:</h2>

    <% if (comments.length === 0) { %>
        <p>Пока никто не оставил отзыв. Будьте первым!</p>
    <% } %>

    <% comments.forEach(comment => { %>
        <div class="comment">
            <a href="/profile/<%= comment.user_id %>" class="avatar-link">
                <img src="<%= comment.avatar_url %>" alt="Аватар" class="avatar">
            </a>
            <div class="comment-body">
                <span class="comment-author"><%= comment.nickname %></span>
                <% if (settings.show_time) { %>
                    <span style="color: #999; font-size: 12px;"><%= new Date(new Date(comment.created_at).getTime() + 3*60*60*1000).toLocaleString('ru-RU') %></span>
                <% } %>
                <p class="comment-text"><%= comment.text %></p>
            </div>
        </div>
    <% }); %>
</body>
</html>